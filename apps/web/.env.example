# Driver behind the UI seam: api (default, live backend) | mock (golden-
# conversation replay, no network calls). Leave unset for the live product;
# uncomment to force the scripted demo.
# VITE_REVI_DRIVER=mock
# Revi API origin (api mode). CORS for :3000 is enabled server-side, and the
# Vite dev server is pinned to 3000 for exactly that reason.
VITE_REVI_API_URL=http://localhost:8000
# Tenant sent on POST /v1/sessions (explicit tenant context, design §12).
VITE_REVI_TENANT=demo
