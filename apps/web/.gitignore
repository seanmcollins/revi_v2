# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/dist
/dist-*
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The EXAMPLE is opted in: it is the only tracked record of the
# three `VITE_REVI_*` settings this app reads, and while it was ignored the
# rename from `NEXT_PUBLIC_*` would have landed on one machine and nowhere
# else. Real `.env` / `.env.local` stay ignored.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
