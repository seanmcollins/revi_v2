# Copy to .env and fill in. Never commit .env.

# --- LLM (Claude Agent SDK) ---
# Optional on a machine with an interactive Claude Code login (the SDK's
# bundled CLI resolves it). Required in CI/headless environments.
ANTHROPIC_API_KEY=
# Mandatory explicit model pin — the app refuses to start without one.
# Accuracy > speed > cost: default to the strongest available model.
REVI_MODEL_PIN=claude-opus-5
# Per-LLM-call budget ceiling in USD (tracked + attributed in traces).
REVI_LLM_MAX_BUDGET_USD=0.50

# --- Application state (Postgres via docker-compose) ---
REVI_DATABASE_URL=postgresql+psycopg://revi:revi_dev_only@localhost:5433/revi

# --- Analytical warehouse (DuckDB mock; regenerate with `make warehouse`) ---
REVI_WAREHOUSE_PATH=data/revi_warehouse.duckdb

# --- Dev tenant (single-tenant local development) ---
REVI_TENANT_ID=demo-tenant

# --- API authentication (required: unconfigured means every /v1 route 401s) ---
# Production: set a signing secret and issue tenant bearer tokens.
#   uv run python -m revi_api.mint_token --new-secret
#   REVI_AUTH_SECRET=... uv run python -m revi_api.mint_token --tenant acme-health
# REVI_AUTH_SECRET=
#
# Local development ONLY: treat every unauthenticated request as this
# tenant. Loudly logged at startup and reported by GET /v1/health as
# `auth_mode`. `make api` sets it so the demo runs without credentials;
# never set it anywhere a real warehouse is reachable.
REVI_AUTH_DEV_TENANT=demo

# Browser origins allowed by CORS (comma-separated; default local dev only).
REVI_CORS_ORIGINS=http://localhost:3000
