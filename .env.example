# Copy to .env and fill in. Never commit .env.
#
# `make api` loads the repo-root .env through the uvicorn entry point
# (apps/api/src/revi_api/main.py) with override=False: anything already
# exported in your shell wins. Nothing else loads it — create_app and
# build_components take an explicit environment mapping, so tests are
# hermetic and never inherit what is in here.

# --- LLM (Claude Agent SDK) ---
# Optional on a machine with an interactive Claude Code login (the SDK's
# bundled CLI resolves it). Required in CI/headless environments.
ANTHROPIC_API_KEY=
# Mandatory explicit model pin — the app refuses to start without one.
# Accuracy > speed > cost: default to the strongest available model.
REVI_MODEL_PIN=claude-opus-5
# Per-LLM-call budget ceiling in USD (tracked + attributed in traces).
REVI_LLM_MAX_BUDGET_USD=0.50
# Wall clock for a whole LLM call INCLUDING its retries. Generous on
# purpose: it exists to cut off a hang, not to trim a slow-but-working call.
REVI_LLM_TIMEOUT_SECONDS=120
# Retries after the first attempt, for transient transport failures only
# (connection, subprocess spawn/death, 5xx/408/429). Schema failures, budget
# refusals and 4xx are never retried. Every attempt lands in the turn trace.
REVI_LLM_MAX_RETRIES=2
# Live SDK subprocesses this process will run at once. Each is a real OS
# process; unbounded, a burst of turns is a fork bomb with a credit card.
REVI_LLM_MAX_CONCURRENCY=4
# Force the scripted demo model (the reference-conversation script; off-script
# calls clarify, never guess). CI sets this; set it locally to demo without
# spending. With it unset and REVI_MODEL_PIN set, `make api` runs live Claude —
# either way the choice is logged at startup and reported by /v1/health.
# REVI_LLM_MOCK=1

# --- Session settings: what this deployment will ACCEPT (§7.1) ---
# Out-of-bounds settings are REFUSED (POLICY_DENIED naming the bound), never
# clamped — a silently lowered budget produces a session whose trace says one
# thing and whose behavior is another. /v1/capabilities publishes these, so a
# client renders only the controls that exist here.
#
# Comma-separated allowlist of model ids a session may pick. Default:
# claude-opus-5,claude-sonnet-5. REVI_MODEL_PIN is always allowed on top of
# whatever is listed — a deployment necessarily permits the model it is
# already running. Ignored under the scripted demo model, which cannot honor
# a per-call model override: naming a tier there is refused rather than
# accepted as a control that would change nothing.
REVI_MODEL_TIERS=claude-opus-5,claude-sonnet-5
# 0 refuses decision traces outright — both the `debug` session setting and
# GET /v1/investigations/{id}/trace. Default on. Traces are RECORDED either
# way; this decides whether they are served.
REVI_DEBUG_TRACE=1
# (REVI_LLM_MAX_BUDGET_USD above is the other bound: it doubles as the
# largest per-turn ceiling a session may set.)

# --- Application state (Postgres via docker-compose) ---
# Commented on purpose. Unset means in-memory stores, chosen quietly; set means
# "Postgres, and shout if it is unreachable" — which is an alarming startup
# error every time docker compose happens to be down. Uncomment together with
# `make db-up && make migrate`.
# REVI_DATABASE_URL=postgresql+psycopg://revi:revi_dev_only@localhost:5433/revi

# --- Analytical warehouse (DuckDB mock; regenerate with `make warehouse`) ---
REVI_WAREHOUSE_PATH=data/revi_warehouse.duckdb
# How often the API process reclaims expired/orphaned cohort tables from the
# warehouse (seconds; 0 disables and leaves reclamation to `make sweep`).
# Cohort materialization is the one thing Revi WRITES to the warehouse — see
# "What Revi writes" in docs/architecture.md.
REVI_COHORT_SWEEP_INTERVAL_SECONDS=3600

# --- Monitors (the proactive surface) ---
# How often the API process checks whether a new load has landed and walks
# every tenant's Monitors at it: each monitor re-run, each claimed resolution
# verified, the detection feed's census recorded (seconds; 0 disables the
# loop). Evaluation happens on watermark ADVANCE, not on every tick, so the
# interval decides how promptly a new load is noticed rather than how much
# work is done.
#
# 0 is safe: `GET /v1/monitors/brief` evaluates whatever it needs on request,
# through the same primitive. What it costs is the idle deployment — nobody
# opens the app, so nothing is walked, and the first person in pays for it.
REVI_MONITORS_SWEEP_INTERVAL_SECONDS=900

# --- Dev tenant (single-tenant local development) ---
REVI_TENANT_ID=demo-tenant

# --- API authentication (required: unconfigured means every /v1 route 401s) ---
# Production: set a signing secret and issue tenant bearer tokens.
#   uv run python -m revi_api.mint_token --new-secret
#   REVI_AUTH_SECRET=... uv run python -m revi_api.mint_token --tenant acme-health
# REVI_AUTH_SECRET=
#
# Local development ONLY: treat every unauthenticated request as this
# tenant. Loudly logged at startup and reported by GET /v1/health as
# `auth_mode`. `make api` sets it so the demo runs without credentials;
# never set it anywhere a real warehouse is reachable.
REVI_AUTH_DEV_TENANT=demo

# Browser origins allowed by CORS (comma-separated; default local dev only).
REVI_CORS_ORIGINS=http://localhost:3000
