                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WindowSpecModel": {
        "additionalProperties": false,
        "description": "A relative window; ``quantity`` is a decimal string (\"1\", \"3.25\").",
        "properties": {
          "mode": {
            "enum": [
              "trailing",
              "full_periods",
              "to_date"
            ],
            "title": "Mode",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "unit": {
            "enum": [
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ],
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "quantity",
          "unit",
          "mode"
        ],
        "title": "WindowSpecModel",
        "type": "object"
      }
    }
  },
